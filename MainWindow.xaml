<Window x:Class="ServiceApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Учёт услуг" Width="440" Height="460" Language="ru-RU">
 <StackPanel Margin="24">
    <TextBlock Text="Карточка услуги" FontSize="24"/>
    <TextBlock Margin="0,8" Text="{Binding Id, StringFormat='ID: {0}'}"/>
    <TextBlock Text="Название"/>
    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Margin="0,8,0,0" Text="Исполнитель"/>
    <TextBox Text="{Binding Worker, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Margin="0,8,0,0" Text="Цена за час, ₽"/>
    <TextBox x:Name="RateBox" Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
    <TextBlock Margin="0,8,0,0" Text="Часы"/>
    <TextBox x:Name="HoursBox" Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
    <TextBlock Margin="0,10" FontWeight="Bold" Text="{Binding Total, StringFormat='Стоимость услуги: {0:N2} ₽'}"/>
    <WrapPanel>
        <Button Padding="8,4" Content="Сохранить" Click="Save_Click"/>
        <Button Padding="8,4" Margin="8,0,0,0" Content="Новая запись" Click="New_Click"/>
    </WrapPanel>
    <TextBlock Margin="0,12,0,3" Text="Поиск по ID"/>
    <DockPanel>
        <Button DockPanel.Dock="Right" Content="Найти" Padding="10,4" Click="Find_Click"/>
        <TextBox x:Name="Search"/>
    </DockPanel>
    <TextBlock x:Name="Status" Margin="0,8" TextWrapping="Wrap"/>
 </StackPanel>
</Window>
